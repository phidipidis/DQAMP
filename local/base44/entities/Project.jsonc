{
  "name": "Project",
  "type": "object",
  "properties": {
    "Project_Code": {
      "type": "string",
      "description": "Unique project code"
    },
    "Project_Title": {
      "type": "string",
      "description": "Project title"
    },
    "Project_Description": {
      "type": "string",
      "description": "Project description"
    },
    "Functional_Division": {
      "type": "string",
      "enum": [
        "CID",
        "SGOD",
        "OSDS"
      ],
      "description": "Functional division"
    },
    "Unit_Section": {
      "type": "string",
      "description": "Unit or section within the division"
    },
    "Operating_Unit": {
      "type": "string",
      "description": "Operating unit responsible for the project"
    },
    "Project_Order": {
      "type": "number",
      "description": "Display order within objective"
    },
    "Project_Start_Date": {
      "type": "string",
      "format": "date",
      "default": "2026-01-05",
      "description": "Project start date"
    },
    "Project_End_Date": {
      "type": "string",
      "format": "date",
      "default": "2026-12-31",
      "description": "Project end date"
    },
    "Project_Status": {
      "type": "string",
      "enum": [
        "Planning",
        "Ongoing",
        "Completed",
        "On Track",
        "At Risk",
        "Delayed"
      ],
      "default": "Planning",
      "description": "Current project status"
    },
    "Owner": {
      "type": "string",
      "description": "Person responsible for the project"
    },
    "Funding_Source": {
      "type": "string",
      "enum": [
        "MOOE",
        "SARO",
        "SEF",
        "Others"
      ],
      "description": "Funding source"
    },
    "Financial_Allocation": {
      "type": "number",
      "description": "Total project budget allocation"
    },
    "Financial_Utilization": {
      "type": "number",
      "description": "Actual project expenditure to date"
    },
    "Variance": {
      "type": "number",
      "description": "Financial variance (Allocation - Utilization)"
    },
    "Utilization_Rate": {
      "type": "number",
      "description": "Budget utilization rate percentage"
    },
    "Budget": {
      "type": "number",
      "description": "Total project budget (legacy)"
    },
    "Actual_Cost": {
      "type": "number",
      "description": "Actual project expenditure (legacy)"
    },
    "Linked_Outputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related Output IDs (many-to-many)"
    },
    "Linked_Activities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related Activity IDs (many-to-many)"
    }
  },
  "required": [
    "Project_Code",
    "Project_Title",
    "Functional_Division"
  ]
}